# Supabase project for PharmacyCDReg (separate from PharmacyConsultation.ie)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 32+ random bytes, used to sign the active-staff (PIN) cookie. openssl rand -hex 32
STAFF_SESSION_SECRET=
NEXT_PUBLIC_SITE_URL=https://pharmacycdreg.ie
# Reads wholesaler invoices / prescriptions. Set ONE of these.
# OpenRouter (same account as Halo). Zero data retention is forced on every call.
OPENROUTER_API_KEY=
# Comma-separated OpenRouter model IDs: first is used, the rest are fallbacks.
# Copy the exact IDs Halo uses (e.g. the Gemini Flash model, then the Qwen fallback).
OPENROUTER_MODELS=
# …or Claude directly:
ANTHROPIC_API_KEY=

# Stripe (same account as PharmacyConsultation.ie, new product/price)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=            # PharmacyCDReg €19/month recurring price (incl. Stripe Tax setting)
STRIPE_WEBHOOK_SECRET=      # endpoint: https://pharmacycdreg.ie/api/stripe/webhook

# Email (Gmail API via Google service account, as PharmacyConsultation.ie)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
EMAIL_FROM=                 # mailbox the service account may send as
EMAIL_FROM_NAME=PharmacyCDReg.ie
ADMIN_NOTIFY_EMAIL=         # where new sign-up / trial alerts go

# Vercel Cron auth for /api/cron/trial-reminders
CRON_SECRET=

# Pre-launch: waitlist on the home page; sign-in hidden behind this access code.
SIGNIN_UNLOCK_CODE=
# Set to 1 to re-open self sign-up (/start → free month)
SIGNUPS_OPEN=
